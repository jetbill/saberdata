# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# --- Base de datos (usadas por compose.yaml y por la aplicación) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saberdata
DB_USER=saberdata
DB_PASSWORD=cambia-esta-clave

# --- Seguridad (se usan desde la Fase 2) ---
# Secreto HS256: mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-de-32-caracteres-o-mas
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@saberdata.local
ADMIN_PASSWORD=cambia-la-clave-del-admin

# --- Ollama (se usan desde la Fase 4) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
